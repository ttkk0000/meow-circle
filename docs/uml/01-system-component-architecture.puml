@startuml 01-system-component-architecture
!theme plain
skinparam defaultFontName "Noto Sans SC"
skinparam shadowing false
title M&D 系统组件与外部能力边界

component "Android / iOS / Desktop" as native
component "KMP clientUi / shared" as kmp
component "Web /app" as web
component "业务 /app/operator 与运维 /app/ops" as ops
component "cmd/server + mobileapi.Handler" as api
component "identity.Service" as identity
component "mobile.Service" as domain
component "mobile.Repository / Tx" as repo
database "PostgreSQL 001–013" as db
component "cmd/worker" as worker
cloud "外部认证 / 年龄 / 高德 / 短信 / 存储" as providers
native --> kmp
kmp --> api : Bearer
web --> api : Cookie + X-MND-CSRF
ops --> api : 具名凭据与角色
worker --> api : 具名job权限
api --> identity
api --> domain
identity --> repo
domain --> repo
repo --> db
api --> providers : 已配置适配器
note bottom of providers : 正式参数与平台联调未完成；执行器及完整搜索接收端保留占位
@enduml

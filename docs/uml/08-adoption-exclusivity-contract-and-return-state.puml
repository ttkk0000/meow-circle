@startuml 08-adoption-exclusivity-contract-and-return-state
!theme plain
skinparam backgroundColor #FFFDF9
skinparam defaultFontName "PingFang SC, Inter, sans-serif"
skinparam roundcorner 8
skinparam StateBorderColor #D8CFC4
skinparam StateBackgroundColor #FFFFFF
skinparam ArrowColor #5C534E

title F07 Adoption Pet-Level Trial Exclusivity, Contract Revision & Bilateral Return State Machine

state "Adoption Listing & Pet Cycle (mobile_adoption_listings)" as ListingSM {
  [*] --> DraftListing : Owner creates listing\n(adoption_cycle = 1)
  DraftListing --> PublishedOpen : Publish listing\n(Qualification + Care Eligibility verified)

  state "PublishedOpen\n(Accepting Applications)" as PublishedOpen
  state "TrialActive\n(Pet-Level Exclusive Lock:\nOnly 1 active trial per pet_id)" as TrialActive
  state "AdoptedCompleted\n(Contract Signed & Handover Confirmed)" as AdoptedCompleted
  state "ReturnedRelisted\n(adoption_cycle + 1:\nPrior applications archived)" as ReturnedRelisted

  PublishedOpen --> TrialActive : Owner selects 1 applicant for Trial\n[SERIALIZABLE check: 0 other active trials for pet_id]\nOther pending applicants -> Waitlisted
  TrialActive --> PublishedOpen : Trial cancelled before handover\n[Waitlisted applicants restored to Submitted]
  TrialActive --> AdoptedCompleted : Both parties accept latest Contract Revision\n& confirm Trial Completion
  AdoptedCompleted --> ReturnedRelisted : Bilateral Return Proposal accepted\n[increments adoption_cycle = cycle + 1]
  ReturnedRelisted --> PublishedOpen : Owner re-opens listing for new cycle
}

state "Adoption Application & Contract Lifecycle (mobile_adoption_applications)" as AppSM {
  [*] --> Submitted : Applicant submits with Reauth\n(bound to listing.adoption_cycle)
  Submitted --> UnderReview : Owner opens review
  Submitted --> Waitlisted : Another applicant enters TrialActive\nfor same pet_id
  UnderReview --> Waitlisted : Another applicant enters TrialActive
  Waitlisted --> UnderReview : Active trial cancelled

  UnderReview --> SelectedForTrial : Owner selects applicant\n(Acquires pet_id trial lock)

  state SelectedForTrial {
    [*] --> ContractDrafting
    ContractDrafting --> ContractRevisionPending : Owner/Applicant proposes\nContract Revision (rev_no++)
    ContractRevisionPending --> ContractRevisionPending : Counter-revision proposed\n(invalidates prior unaccepted rev_no)
    ContractRevisionPending --> ContractAccepted : Counterparty accepts exact\nlatest rev_no with Reauth
  }

  SelectedForTrial --> CompletedAdopted : Handover & trial period confirmed

  state "Post-Adoption Bilateral Return Sub-State" as ReturnSM {
    CompletedAdopted --> ReturnProposed : Either Owner or Adopter submits\nReturn Proposal (with reason & 72h expiry)
    ReturnProposed --> CompletedAdopted : Proposer withdraws proposal\nOR 72h deadline expires (cmd/worker)\nOR counterparty declines
    ReturnProposed --> ReturnedClosed : Counterparty accepts Return Proposal\n(triggers listing adoption_cycle++)
  }

  Submitted --> WithdrawnOrArchived : Applicant withdraws OR\nlisting enters new adoption_cycle
}

@enduml

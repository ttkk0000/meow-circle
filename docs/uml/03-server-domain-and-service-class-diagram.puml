@startuml 03-server-domain-and-service-class-diagram
!theme plain
skinparam defaultFontName "Noto Sans SC"
skinparam shadowing false
title Go 服务、事务端口与适配器类关系

class Handler {
HTTP与浏览器适配
会话 / Origin / CSRF
}
class "identity.Service" as IdentityService {
账号认证与资格
年龄与监护邀请
}
class "mobile.Service" as MobileService {
领域命令与权限
领养 / 预约 / 线索
}
class Repository {
View(ctx, fn)
Update(ctx, fn)
}
class Tx {
Get / ByKey / List
Save / Delete / Count
}
class Record {
ID / OwnerID / RefID
State / Version / Data
}
class mobileRepository {
pgx事务适配
只读RepeatableRead
写Serializable
}
class mobileTx {
SQL与CAS
聚合表白名单
}
class Runner {
Tick / Load / Save
具名job与检查点
}
Handler --> IdentityService : 调用
Handler --> MobileService : 调用
IdentityService --> Repository : 依赖
MobileService --> Repository : 依赖
Repository --> Tx : 事务回调
mobileRepository --> Repository : 实现
mobileTx --> Tx : 实现
Tx --> Record : 读写
Runner --> Handler : HTTP作业
@enduml

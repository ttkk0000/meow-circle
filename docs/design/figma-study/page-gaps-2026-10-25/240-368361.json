lex font-['Noto_Sans_SC:Regular'] font-normal h-[28px] items-center leading-[20px] overflow-clip px-[16px] relative shrink-0 text-[12px] w-[390px]\" data-node-id=\"242:375534\" data-name=\"Status / learning disclosure\">\n        <p className=\"relative shrink-0 text-[color:var(--mnd-study-color-ink,#202329)] w-[60px]\" data-node-id=\"242:375535\">\n          9:41\n        </p>\n        <p className=\"relative shrink-0 text-[color:var(--mnd-study-color-muted,#616771)] text-right w-[298px]\" data-node-id=\"242:375536\">\n          学习示意 · 非真实数据\n        </p>\n      </div>\n      <div className=\"bg-[var(--mnd-study-color-surface,#fffefc)] content-stretch flex gap-[4px] h-[56px] items-center overflow-clip p-[4px] relative shrink-0 w-[390px]\" data-node-id=\"242:375537\" data-name=\"Toolbar\">\n        <button className=\"content-stretch cursor-pointer flex flex-col items-start overflow-clip p-[12px] relative rounded-[24px] shrink-0 size-[48px]\" data-node-id=\"242:375538\" data-name=\"Back\">\n          <div className=\"content-stretch flex flex-col gap-[var(--mnd-study-space-8,8px)] items-start relative shrink-0 size-[24px]\" data-node-id=\"242:375539\" data-name=\"Instance / icon/chevron-left\">\n            <div className=\"relative shrink-0 size-[24px]\" data-node-id=\"I242:375539;56:154\" data-name=\"Lucide / chevron-left\">\n              <img alt=\"\" className=\"absolute block inset-0 max-w-none size-full\" src={imgLucideChevronLeft} />\n            </div>\n          </div>\n        </button>\n        <p className=\"[word-break:break-word] font-['Noto_Sans_SC:Bold'] font-bold leading-[30px] relative shrink-0 text-[20px] text-[color:var(--mnd-study-color-ink,#202329)] w-[326px]\" data-node-id=\"242:375543\">\n          正在添加照片\n        </p>\n      </div>\n      <div className=\"content-stretch flex flex-col h-[672px] items-start overflow-x-clip overflow-y-auto relative shrink-0 w-[390px]\" data-node-id=\"242:375544\" data-name=\"Scrollable viewport\">\n        <div className=\"content-stretch flex flex-col gap-[16px] items-start overflow-clip p-[16px] relative shrink-0 w-[390px]\" data-node-id=\"242:375545\" data-name=\"Task content\">\n          <div className=\"[word-break:break-word] content-stretch flex flex-col gap-[16px] items-start overflow-clip relative shrink-0 w-[358px]\" data-node-id=\"242:375546\" data-name=\"Progress\">\n            <div className=\"bg-[var(--mnd-study-color-surface,#fffefc)] content-stretch flex flex-col gap-[8px] items-start overflow-clip p-[16px] relative rounded-[16px] shrink-0 w-[358px]\" data-node-id=\"242:375547\" data-name=\"Notice / 照片 1 · 已完成\">\n              <p className=\"font-['Noto_Sans_SC:Bold'] font-bold leading-[24px] relative shrink-0 text-[16px] text-[color:var(--mnd-study-color-ink,#202329)] w-[326px]\" data-node-id=\"242:375548\">\n                照片 1 · 已完成\n              </p>\n              <p className=\"font-['Noto_Sans_SC:Regular'] font-normal leading-[20px] relative shrink-0 text-[12px] text-[color:var(--mnd-study-color-muted,#616771)] w-[326px]\" data-node-id=\"242:375549\">\n                已加入本次草稿\n              </p>\n            </div>\n            <div className=\"bg-[var(--mnd-study-color-surface,#fffefc)] content-stretch flex flex-col gap-[8px] items-start overflow-clip p-[16px] relative rounded-[16px] shrink-0 w-[358px]\" data-node-id=\"242:375550\" data-name=\"Notice / 照片 2 · 上传中 60%\">\n              <p className=\"font-['Noto_Sans_SC:Bold'] font-bold leading-[24px] relative shrink-0 text-[16px] text-[color:var(--mnd-study-color-ink,#202329)] w-[326px]\" data-node-id=\"242:375551\">\n                照片 2 · 上传中 60%\n              </p>\n              <p className=\"font-['Noto_Sans_SC:Regular'] font-normal leading-[20px] relative shrink-0 text-[12px] text-[color:var(--mnd-study-color-muted,#616771)] w-[326px]\" data-node-id=\"242:375552\">\n                离开前可保留草稿\n              </p>\n            </div>\n            <div className=\"bg-[var(--mnd-study-color
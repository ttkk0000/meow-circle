# 仅Android构建环境；实际执行前从私有配置／Secret管理器注入。
MND_API_BASE_URL=https://mnd.example.invalid
MND_VERSION_NAME=0.1.0
MND_VERSION_CODE=1
MND_ANDROID_KEYSTORE=/REPLACE_WITH_PRIVATE_PATH/mnd-release.jks
MND_ANDROID_KEY_ALIAS=REPLACE_WITH_KEY_ALIAS
MND_ANDROID_STORE_PASSWORD=
MND_ANDROID_KEY_PASSWORD=
MND_AMAP_ANDROID_KEY=
MND_WECHAT_ANDROID_APP_ID=wx0000000000000000
MND_QQ_ANDROID_APP_ID=00000000

# 可选FCM公开应用配置；四项一起提供，不含服务端推送凭据。默认不初始化。
MND_FCM_ANDROID_APP_ID=
MND_FCM_PROJECT_ID=
MND_FCM_SENDER_ID=
MND_FCM_ANDROID_API_KEY=
